# PartnerProof environment configuration
#
# The app runs with no configuration at all: AI features fall back to
# deterministic mocks and uploads go to local disk. Everything below is opt-in.

# ---------------------------------------------------------------------------
# Agent model providers
# ---------------------------------------------------------------------------
# Configure at least one to use the /agents workflows. Providers with no
# credentials show up disabled in the UI rather than failing at run time.

# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=                    # optional: route through a gateway

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.2
# OPENAI_BASE_URL=                       # optional: an OpenAI-compatible gateway
#                                        # (not Azure OpenAI — that needs the
#                                        # SDK's AzureOpenAI client)

# Google Gemini. The API has a free daily quota that needs no subscription —
# get a key from https://aistudio.google.com. Note that enabling billing on a
# Google Cloud project removes the free tier for that project, and free-tier
# prompts may be used for model training.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL=                       # optional override

# Local model over any OpenAI-compatible endpoint.
#   LM Studio -> http://localhost:1234/v1
#   Ollama    -> http://localhost:11434/v1
#   vLLM      -> http://localhost:8000/v1
# LOCAL_MODEL_BASE_URL=http://localhost:1234/v1
# LOCAL_MODEL=qwen3.5-9b
# LOCAL_MODELS=qwen3.5-9b,qwen3.6-27b    # optional: populates the model picker
# LOCAL_MODEL_API_KEY=                   # optional; most local servers ignore it

# Any other OpenAI-compatible endpoint: Groq, Together, OpenRouter, Fireworks,
# DeepSeek, an internal gateway, and so on.
# CUSTOM_BASE_URL=https://api.groq.com/openai/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
# CUSTOM_MODELS=                         # optional: populates the model picker

# Default provider when a run does not name one:
#   anthropic | openai | gemini | local | custom
# Falls through to whichever provider is configured.
# AGENT_PROVIDER=anthropic

# Concurrent agent runs allowed per server process (default 4).
# AGENT_MAX_CONCURRENT_RUNS=4

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# S3 is used automatically when S3_BUCKET is set; otherwise files go to
# .data/uploads. Set STORAGE_DRIVER to pin one explicitly.
# STORAGE_DRIVER=s3
# S3_BUCKET=partnerproof-uploads
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=                     # optional: falls back to the default
# AWS_SECRET_ACCESS_KEY=                 # AWS credential chain (IAM role, SSO)
# S3_ENDPOINT=                           # optional: MinIO / Cloudflare R2
# S3_FORCE_PATH_STYLE=true               # required by MinIO

# ---------------------------------------------------------------------------
# Legacy AI seams (contract extractor + rule-based assistant)
# ---------------------------------------------------------------------------
# Which provider the non-agent AI features use: "mock" (default), "anthropic",
# or "openai". See src/lib/extractor.ts and src/lib/assistant.ts.
AI_PROVIDER=mock
