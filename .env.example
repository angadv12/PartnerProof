# PartnerProof environment configuration
#
# The MVP runs fully WITHOUT any API keys using deterministic mock implementations.
# Provide a key below only when you want to swap the mock AI for a real LLM provider.
# See src/lib/extractor.ts and src/lib/assistant.ts for the provider abstraction.

# Anthropic (Claude) — enables the LLM-backed ContractExtractor / Assistant when set.
# ANTHROPIC_API_KEY=

# OpenAI — alternative provider hook.
# OPENAI_API_KEY=

# Which provider to use for AI features: "mock" (default), "anthropic", or "openai".
AI_PROVIDER=mock
